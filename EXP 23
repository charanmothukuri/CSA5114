#include <stdio.h>

/* ---------- S-DES TABLES ---------- */

/* P10 */
int P10[10] = {
    3, 5, 2, 7, 4, 10, 1, 9, 8, 6
};

/* P8 */
int P8[8] = {
    6, 3, 7, 4, 8, 5, 10, 9
};

/* Initial Permutation */
int IP[8] = {
    2, 6, 3, 1, 4, 8, 5, 7
};

/* Inverse Initial Permutation */
int IP_INV[8] = {
    4, 1, 3, 5, 7, 2, 8, 6
};

/* Expansion / Permutation */
int EP[8] = {
    4, 1, 2, 3, 2, 3, 4, 1
};

/* P4 */
int P4[4] = {
    2, 4, 3, 1
};

/* S0 */
int S0[4][4] = {
    {1, 0, 3, 2},
    {3, 2, 1, 0},
    {0, 2, 1, 3},
    {3, 1, 3, 2}
};

/* S1 */
int S1[4][4] = {
    {0, 1, 2, 3},
    {2, 0, 1, 3},
    {3, 0, 1, 0},
    {2, 1, 0, 3}
};

/* ---------- PERMUTATION ---------- */

int permutation(int input, int table[],
                int tableSize, int inputBits)
{
    int output = 0;
    int i;

    for (i = 0; i < tableSize; i++)
    {
        int bit;

        bit = (input >> (inputBits - table[i])) & 1;

        output = (output << 1) | bit;
    }

    return output;
}

/* ---------- 5-BIT LEFT SHIFT ---------- */

int leftShift5(int value, int shifts)
{
    value &= 0x1F;

    return ((value << shifts) |
            (value >> (5 - shifts))) & 0x1F;
}

/* ---------- KEY GENERATION ---------- */

void generateKeys(int key10, int *K1, int *K2)
{
    int p10;
    int left;
    int right;

    /* Apply P10 */
    p10 = permutation(key10, P10, 10, 10);

    /* Split into two 5-bit halves */
    left = (p10 >> 5) & 0x1F;
    right = p10 & 0x1F;

    /* Left shift by 1 */
    left = leftShift5(left, 1);
    right = leftShift5(right, 1);

    /* Generate K1 */
    *K1 = permutation(
        (left << 5) | right,
        P8,
        8,
        10
    );

    /* Left shift by 2 */
    left = leftShift5(left, 2);
    right = leftShift5(right, 2);

    /* Generate K2 */
    *K2 = permutation(
        (left << 5) | right,
        P8,
        8,
        10
    );
}

/* ---------- S-BOX ---------- */

int sbox(int input, int box[4][4])
{
    int row;
    int column;

    /*
       4-bit input:

       b3 b2 b1 b0

       Row    = b3b0
       Column = b2b1
    */

    row = ((input & 0x08) >> 2) |
          (input & 0x01);

    column = (input >> 1) & 0x03;

    return box[row][column];
}

/* ---------- F FUNCTION ---------- */

int fk(int input, int key)
{
    int left;
    int right;
    int expanded;
    int xored;
    int sboxOutput;
    int p4;

    left = (input >> 4) & 0x0F;
    right = input & 0x0F;

    /* Expansion */
    expanded = permutation(
        right,
        EP,
        8,
        4
    );

    /* XOR with key */
    xored = expanded ^ key;

    /* S-box substitution */
    sboxOutput =
        (sbox((xored >> 4) & 0x0F, S0) << 2)
        |
        sbox(xored & 0x0F, S1);

    /* P4 */
    p4 = permutation(
        sboxOutput,
        P4,
        4,
        4
    );

    /* XOR with left half */
    left = left ^ p4;

    return (left << 4) | right;
}

/* ---------- SWAP ---------- */

int swapHalves(int input)
{
    int left;
    int right;

    left = (input >> 4) & 0x0F;
    right = input & 0x0F;

    return (right << 4) | left;
}

/* ---------- S-DES ENCRYPTION ---------- */

int SDES_encrypt(int plaintext,
                 int K1,
                 int K2)
{
    int value;

    /* Initial permutation */
    value = permutation(
        plaintext,
        IP,
        8,
        8
    );

    /* Round 1 */
    value = fk(value, K1);

    /* Swap */
    value = swapHalves(value);

    /* Round 2 */
    value = fk(value, K2);

    /* Inverse initial permutation */
    value = permutation(
        value,
        IP_INV,
        8,
        8
    );

    return value;
}

/* ---------- S-DES DECRYPTION ---------- */

int SDES_decrypt(int ciphertext,
                 int K1,
                 int K2)
{
    int value;

    /* Initial permutation */
    value = permutation(
        ciphertext,
        IP,
        8,
        8
    );

    /* Reverse key order */
    value = fk(value, K2);

    /* Swap */
    value = swapHalves(value);

    /* Round 2 */
    value = fk(value, K1);

    /* Inverse initial permutation */
    value = permutation(
        value,
        IP_INV,
        8,
        8
    );

    return value;
}

/* ---------- PRINT BINARY ---------- */

void printBinary8(int value)
{
    int i;

    for (i = 7; i >= 0; i--)
    {
        printf("%d", (value >> i) & 1);
    }
}

/* ---------- CTR ENCRYPTION ---------- */

void CTR_encrypt(int plaintext[],
                 int ciphertext[],
                 int blocks,
                 int counter,
                 int K1,
                 int K2)
{
    int i;
    int keystream;

    for (i = 0; i < blocks; i++)
    {
        /*
         * Encrypt counter to generate
         * keystream.
         */
        keystream =
            SDES_encrypt(
                counter,
                K1,
                K2
            );

        /*
         * XOR plaintext with keystream.
         */
        ciphertext[i] =
            plaintext[i] ^ keystream;

        /*
         * Increment counter.
         */
        counter++;
    }
}

/* ---------- CTR DECRYPTION ---------- */

void CTR_decrypt(int ciphertext[],
                 int plaintext[],
                 int blocks,
                 int counter,
                 int K1,
                 int K2)
{
    int i;
    int keystream;

    for (i = 0; i < blocks; i++)
    {
        /*
         * Generate the same keystream.
         */
        keystream =
            SDES_encrypt(
                counter,
                K1,
                K2
            );

        /*
         * XOR ciphertext with keystream.
         */
        plaintext[i] =
            ciphertext[i] ^ keystream;

        /*
         * Increment counter.
         */
        counter++;
    }
}

/* ---------- MAIN ---------- */

int main()
{
    /*
     * Key:
     * 01111 11101
     *
     * = 0111111101
     * = 0x1FD
     */
    int key = 0x1FD;

    /*
     * Counter starts at:
     * 00000000
     */
    int counter = 0x00;

    /*
     * Plaintext:
     *
     * 00000001
     * 00000010
     * 00000100
     */
    int plaintext[3] = {
        0x01,
        0x02,
        0x04
    };

    int ciphertext[3];
    int decrypted[3];

    int K1;
    int K2;

    int i;

    /* Generate S-DES keys */
    generateKeys(key, &K1, &K2);

    printf("========================================\n");
    printf("        S-DES COUNTER MODE (CTR)\n");
    printf("========================================\n");

    printf("\nKey       : ");

    for (i = 9; i >= 0; i--)
        printf("%d", (key >> i) & 1);

    printf("\nCounter   : ");
    printBinary8(counter);

    printf("\n\nGenerated Keys:\n");

    printf("K1        : ");
    printBinary8(K1);

    printf("\nK2        : ");
    printBinary8(K2);

    /* Encryption */
    CTR_encrypt(
        plaintext,
        ciphertext,
        3,
        counter,
        K1,
        K2
    );

    printf("\n\nPlaintext:\n");

    for (i = 0; i < 3; i++)
    {
        printBinary8(plaintext[i]);
        printf(" ");
    }

    printf("\n\nCiphertext:\n");

    for (i = 0; i < 3; i++)
    {
        printBinary8(ciphertext[i]);
        printf(" ");
    }

    /* Decryption */
    CTR_decrypt(
        ciphertext,
        decrypted,
        3,
        counter,
        K1,
        K2
    );

    printf("\n\nDecrypted plaintext:\n");

    for (i = 0; i < 3; i++)
    {
        printBinary8(decrypted[i]);
        printf(" ");
    }

    printf("\n");

    return 0;
}
