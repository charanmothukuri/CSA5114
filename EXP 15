#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX 1000
#define ALPHABET 26


double englishFreq[26] = {
    8.167, 1.492, 2.782, 4.253, 12.702, 2.228,
    2.015, 6.094, 6.966, 0.153, 0.772, 4.025,
    2.406, 6.749, 7.507, 1.929, 0.095, 5.987,
    6.327, 9.056, 2.758, 0.978, 2.360, 0.150,
    1.974, 0.074
};

typedef struct {
    int key;
    double score;
    char plaintext[MAX];
} Result;


void decrypt(char cipher[], char plain[], int key)
{
    int i;

    for (i = 0; cipher[i] != '\0'; i++)
    {
        if (isalpha((unsigned char)cipher[i]))
        {
            char base = isupper((unsigned char)cipher[i]) ? 'A' : 'a';

            plain[i] = (cipher[i] - base - key + 26) % 26 + base;
        }
        else
        {
            plain[i] = cipher[i];
        }
    }

    plain[i] = '\0';
}

double calculateScore(char text[])
{
    int count[26] = {0};
    int total = 0;
    int i;
    double score = 0.0;

    for (i = 0; text[i] != '\0'; i++)
    {
        if (isalpha((unsigned char)text[i]))
        {
            int index = tolower((unsigned char)text[i]) - 'a';
            count[index]++;
            total++;
        }
    }

    if (total == 0)
        return 999999.0;

    /*
       Lower score means the letter frequencies
       are closer to normal English.
    */
    for (i = 0; i < 26; i++)
    {
        double observed = (double)count[i] / total * 100.0;

        score += (observed - englishFreq[i]) *
                 (observed - englishFreq[i]);
    }

    return score;
}

/* Sort results by score */
void sortResults(Result results[], int n)
{
    int i, j;
    Result temp;

    for (i = 0; i < n - 1; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (results[j].score < results[i].score)
            {
                temp = results[i];
                results[i] = results[j];
                results[j] = temp;
            }
        }
    }
}

int main()
{
    char ciphertext[MAX];
    Result results[26];

    int i;
    int top;

    printf("========================================\n");
    printf(" AUTOMATIC ADDITIVE CIPHER ATTACK\n");
    printf("========================================\n");

    printf("\nEnter ciphertext: ");
    fgets(ciphertext, MAX, stdin);

    /* Remove newline */
    ciphertext[strcspn(ciphertext, "\n")] = '\0';

    printf("How many possible plaintexts to display? ");
    scanf("%d", &top);

    if (top < 1)
        top = 1;

    if (top > 26)
        top = 26;

    /* Try all 26 possible keys */
    for (i = 0; i < 26; i++)
    {
        results[i].key = i;

        decrypt(ciphertext,
                results[i].plaintext,
                i);

        results[i].score =
            calculateScore(results[i].plaintext);
    }

    sortResults(results, 26);

    printf("\n========================================\n");
    printf(" TOP %d POSSIBLE PLAINTEXTS\n", top);
    printf("========================================\n");

    for (i = 0; i < top; i++)
    {
        printf("\n%d. Key = %d\n", i + 1, results[i].key);
        printf("   Score = %.3f\n", results[i].score);
        printf("   Plaintext = %s\n",
               results[i].plaintext);
    }

    return 0;
}
