#include <stdio.h>
#include <string.h>
#include <openssl/des.h>

int main()
{
    DES_cblock key1, key2, key3;
    DES_key_schedule ks1, ks2, ks3;

    DES_cblock iv;
    DES_cblock current_iv;

    unsigned char plaintext[1024];
    unsigned char ciphertext[1024];

    int length;
    int padded_length;
    int i;

    /*
     * 3DES uses three 64-bit DES keys.
     * These are example keys for demonstration.
     */
    memcpy(key1, "12345678", 8);
    memcpy(key2, "abcdefgh", 8);
    memcpy(key3, "87654321", 8);

    /*
     * Initialization Vector (IV)
     */
    memcpy(iv, "ABCDEFGH", 8);

    /*
     * Create DES key schedules
     */
    DES_set_key_unchecked(&key1, &ks1);
    DES_set_key_unchecked(&key2, &ks2);
    DES_set_key_unchecked(&key3, &ks3);

    printf("Enter plaintext: ");

    fgets((char *)plaintext, sizeof(plaintext), stdin);

    length = strlen((char *)plaintext);

    if (plaintext[length - 1] == '\n')
    {
        plaintext[length - 1] = '\0';
        length--;
    }

    /*
     * CBC requires the plaintext length
     * to be a multiple of 8 bytes.
     *
     * Add zero padding.
     */
    padded_length = ((length + 7) / 8) * 8;

    for (i = length; i < padded_length; i++)
        plaintext[i] = 0;

    /*
     * Copy IV because CBC encryption
     * changes the IV for every block.
     */
    memcpy(current_iv, iv, 8);

    /*
     * Encrypt each 8-byte block using
     * 3DES in CBC mode.
     *
     * 3DES = DES(K1) -> DES(K2) decrypt
     *        -> DES(K3)
     */
    DES_ede3_cbc_encrypt(
        plaintext,
        ciphertext,
        padded_length,
        &ks1,
        &ks2,
        &ks3,
        &current_iv,
        DES_ENCRYPT
    );

    printf("\nPlaintext : %s\n", plaintext);

    printf("Ciphertext: ");

    for (i = 0; i < padded_length; i++)
    {
        printf("%02X", ciphertext[i]);
    }

    printf("\n");

    return 0;
}
