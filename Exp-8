#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char plain[] = "abcdefghijklmnopqrstuvwxyz";
    char cipher[] = "CIPHERABDFGJKLMNOQSTUVWXYZ";
    char text[100];
    int i, j;

    printf("Enter plaintext (lowercase): ");
    scanf("%s", text);

    printf("Ciphertext: ");

    for(i = 0; text[i] != '\0'; i++) {
        if(isalpha(text[i])) {
            for(j = 0; j < 26; j++) {
                if(text[i] == plain[j]) {
                    printf("%c", cipher[j]);
                    break;
                }
            }
        } else {
            printf("%c", text[i]);
        }
    }

    printf("\n");
    return 0;
}
