#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char cipher[100];
    int a = 3, b = 15;
    int a_inv = 9;   // Inverse of 3 modulo 26
    int i, c, p;

    printf("Enter ciphertext (uppercase): ");
    scanf("%s", cipher);

    printf("Plaintext: ");

    for(i = 0; i < strlen(cipher); i++) {
        if(isalpha(cipher[i])) {
            c = cipher[i] - 'A';
            p = (a_inv * (c - b + 26)) % 26;
            printf("%c", p + 'A');
        } else {
            printf("%c", cipher[i]);
        }
    }

    printf("\n");
    return 0;
}
