#include <stdio.h>

int modInverse(int a, int m)
{
    a = a % m;
    for (int x = 1; x < m; x++)
    {
        if ((a * x) % m == 1)
            return x;
    }
    return -1;
}

int main()
{
    // Plaintext pairs: HE LP
    // Ciphertext pairs: HI AT

    int P[2][2] = {
        {7, 11},   // H L
        {4, 15}    // E P
    };

    int C[2][2] = {
        {7, 0},    // H A
        {8, 19}    // I T
    };

    int det, invDet;
    int Pinv[2][2];
    int Key[2][2];
    int i, j;

    
    det = (P[0][0] * P[1][1] - P[0][1] * P[1][0]) % 26;
    if (det < 0)
        det += 26;

    invDet = modInverse(det, 26);

    if (invDet == -1)
    {
        printf("Inverse does not exist.\n");
        return 0;
    }

    Pinv[0][0] = ( P[1][1] * invDet) % 26;
    Pinv[0][1] = ((-P[0][1] + 26) * invDet) % 26;
    Pinv[1][0] = ((-P[1][0] + 26) * invDet) % 26;
    Pinv[1][1] = ( P[0][0] * invDet) % 26;

    // Recover Key = C × P⁻¹ mod 26
    for(i = 0; i < 2; i++)
    {
        for(j = 0; j < 2; j++)
        {
            Key[i][j] =
            (C[i][0] * Pinv[0][j] +
             C[i][1] * Pinv[1][j]) % 26;
        }
    }

    printf("Recovered Key Matrix:\n");
    printf("%2d %2d\n", Key[0][0], Key[0][1]);
    printf("%2d %2d\n", Key[1][0], Key[1][1]);

    return 0;
}
