#include <stdio.h>
#include <stdint.h>

/* PC-1: 64 bits -> 56 bits */
int PC1[56] = {
    57,49,41,33,25,17,9,
    1,58,50,42,34,26,18,
    10,2,59,51,43,35,27,
    19,11,3,60,52,44,36,
    63,55,47,39,31,23,15,
    7,62,54,46,38,30,22,
    14,6,61,53,45,37,29,
    21,13,5,28,20,12,4
};

/* PC-2: 56 bits -> 48 bits */
int PC2[48] = {
    14,17,11,24,1,5,
    3,28,15,6,21,10,
    23,19,12,4,26,8,
    16,7,27,20,13,2,
    41,52,31,37,47,55,
    30,40,51,45,33,48,
    44,49,39,56,34,53,
    46,42,50,36,29,32
};

/* DES left-shift schedule */
int shifts[16] = {
    1,1,2,2,2,2,2,2,
    1,2,2,2,2,2,2,1
};

/* Generic permutation */
uint64_t permute(uint64_t input,
                 int table[],
                 int outputSize,
                 int inputSize)
{
    uint64_t output = 0;
    int i;

    for (i = 0; i < outputSize; i++)
    {
        output <<= 1;

        output |=
            (input >> (inputSize - table[i])) & 1;
    }

    return output;
}

/* Circular left shift for 28-bit value */
uint32_t leftShift28(uint32_t value, int shift)
{
    return ((value << shift) |
            (value >> (28 - shift))) & 0x0FFFFFFF;
}

/* Generate the 16 DES subkeys */
void generateSubkeys(uint64_t key,
                     uint64_t subkeys[16])
{
    uint64_t permutedKey;

    uint32_t C;
    uint32_t D;

    uint64_t combined;

    int i;

    /*
     * Step 1:
     * Apply PC-1.
     *
     * 64-bit key -> 56-bit key
     */
    permutedKey =
        permute(key, PC1, 56, 64);

    /*
     * Step 2:
     * Divide the 56-bit key into
     * two 28-bit halves.
     */
    C = (permutedKey >> 28) & 0x0FFFFFFF;
    D = permutedKey & 0x0FFFFFFF;

    /*
     * Step 3:
     * Generate K1 to K16.
     */
    for (i = 0; i < 16; i++)
    {
        /*
         * Left circular shifts
         */
        C = leftShift28(C, shifts[i]);
        D = leftShift28(D, shifts[i]);

        /*
         * Combine C and D.
         */
        combined =
            ((uint64_t)C << 28) | D;

        /*
         * PC-2 selects:
         * 24 bits from C
         * 24 bits from D
         *
         * Total = 48-bit subkey
         */
        subkeys[i] =
            permute(combined,
                   PC2,
                   48,
                   56);
    }
}

int main()
{
    uint64_t key;
    uint64_t subkeys[16];

    int i;

    printf("=====================================\n");
    printf("       DES SUBKEY GENERATION\n");
    printf("=====================================\n");

    printf("\nEnter 64-bit DES key in hexadecimal: ");
    scanf("%llx", &key);

    generateSubkeys(key, subkeys);

    printf("\nGenerated DES Subkeys:\n");

    for (i = 0; i < 16; i++)
    {
        printf("K%-2d = %012llX\n",
               i + 1,
               subkeys[i]);
    }

    return 0;
}
